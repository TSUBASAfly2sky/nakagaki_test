<script>
/* LPモーション：スクロール表示・カウントアップ・ヘッダー影（reduced-motionでは無効） */
(function(){
  var bar=document.createElement('div'); bar.id='scrollbar'; document.body.appendChild(bar);
  function prog(){ var st=window.scrollY||0, hh=document.documentElement.scrollHeight-window.innerHeight; bar.style.width=(hh>0?(st/hh*100):0)+'%'; }
  window.addEventListener('scroll',prog,{passive:true}); prog();
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var io=new IntersectionObserver(function(es){es.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });},{threshold:0.06, rootMargin:'0px 0px -40px 0px'});
  /* 保険：最下部までスクロールしても未表示の要素を確実に出す */
  window.addEventListener('scroll',function(){ if((window.innerHeight+(window.scrollY||0)) >= document.documentElement.scrollHeight-4){ [].slice.call(document.querySelectorAll('.reveal:not(.in),.rmask:not(.in)')).forEach(function(e){ e.classList.add('in'); }); } },{passive:true});
  var vh=window.innerHeight||800;
  function reg(e){ if(e.getBoundingClientRect().top < vh*0.9){ e.classList.add('in'); } else { io.observe(e); } }
  /* マスク見出し（下から迫り上がる） */
  [].slice.call(document.querySelectorAll('.st')).forEach(function(hd){ if(hd.closest('.hero'))return; var sp=document.createElement('span'); sp.className='rmask-i'; while(hd.firstChild) sp.appendChild(hd.firstChild); hd.appendChild(sp); hd.classList.add('rmask'); reg(hd); });
  /* ブラー＋迫り上がり（画像もここに含める＝確実に表示） */
  var sel='.st-sub,.pain,.reason,.plan,.heroplan,.subplan,.subhead,.rtbc,.step3,.voice,.cbox,.cplus,.payoff,.eco,.flow,.gapfig,.midcta .wrap,.cho img,.growth-hero,.cho h3,.cho p,.cho .sign,.growth .gtxt,.turn .q,.turn .a,.proof .pf>div,.faq details,.formcard,.officeinfo .wrap,.assure-bar span';
  var els=[].slice.call(document.querySelectorAll(sel)).filter(function(e){return !e.closest('.hero');});
  document.querySelectorAll('.pain-grid,.reasons,.plans,.subplans,.rtb,.steps,.voices,.proof .pf').forEach(function(g){ [].slice.call(g.children).forEach(function(c,i){ c.style.transitionDelay=(i*0.12)+'s'; }); });
  els.forEach(function(e){ e.classList.add('reveal'); reg(e); });
  var hdr=document.querySelector('header'); var hp=document.querySelector('.hero-photo'); var wide=window.innerWidth>860;
  function onS(){ if(hdr) hdr.classList.toggle('scrolled',(window.scrollY||0)>8); if(hp&&wide){ var y=window.scrollY||0; if(y<900) hp.style.objectPosition='25% '+(50+y*0.03)+'%'; } }
  window.addEventListener('scroll',onS,{passive:true}); onS();
  /* 実績のカウントアップ */
  function fmt(n,dec,comma){ var s=dec>0?n.toFixed(dec):Math.round(n).toString(); if(comma){ var p=s.split('.'); p[0]=p[0].replace(/\B(?=(\d{3})+(?!\d))/g,','); s=p.join('.'); } return s; }
  var pf=document.querySelector('.proof .pf');
  if(pf){ var done=false;
    var pio=new IntersectionObserver(function(es){ es.forEach(function(en){ if(en.isIntersecting&&!done){ done=true; pio.disconnect();
      [].slice.call(document.querySelectorAll('.proof .pv')).forEach(function(pv){
        var t=pv.firstChild; if(!t||t.nodeType!==3) return; var raw=(t.nodeValue||'').trim();
        var num=parseFloat(raw.replace(/,/g,'')); if(isNaN(num)) return;
        var dec=(raw.split('.')[1]||'').length, comma=raw.indexOf(',')>=0, start=0, dur=1900;
        t.nodeValue=fmt(0,dec,comma);
        function step(ts){ if(!start)start=ts; var p=Math.min(1,(ts-start)/dur), e=1-Math.pow(1-p,3); t.nodeValue=fmt(num*e,dec,comma); if(p<1)requestAnimationFrame(step); else t.nodeValue=fmt(num,dec,comma); }
        requestAnimationFrame(step);
      });
    }});},{threshold:0.35});
    pio.observe(pf);
  }
})();
</script>


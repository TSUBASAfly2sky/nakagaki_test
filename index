<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>めんどうな経理は、まるごとお任せ。商売は、一緒に伸ばす。｜中垣健税理士事務所（税務顧問・寄り添い型）LPドラフト</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#1a1a2e; --ink:#1f2436; --sub:#5a6377; --line:#e7ebf2; --paper:#f5f7fb;
    --green:#2E7D32; --green-l:#4CAF50; --red:#c62828; --red-l:#e74c3c;
    --orange:#E65100; --orange-l:#f39c12; --blue:#1565C0; --blue-l:#4a69bd;
    --maxw:1080px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{font-family:'Noto Sans JP',sans-serif; color:var(--ink); background:#fff; line-height:1.85; -webkit-font-smoothing:antialiased; font-size:16px;}
  img{max-width:100%;}
  .wrap{max-width:var(--maxw); margin:0 auto; padding:0 22px;}
  .sec{padding:78px 0;}
  .sec.tight{padding:56px 0;}
  h2.st{font-size:30px; font-weight:900; line-height:1.4; text-align:center; letter-spacing:.01em;}
  h2.st .accent{color:var(--orange);}
  .st-sub{text-align:center; color:var(--sub); font-size:15px; margin-top:12px;}
  .st-bar{width:56px; height:5px; background:var(--orange); border-radius:3px; margin:16px auto 0;}
  .cta-btn{display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#E65100,#f39c12); color:#fff; font-weight:900; font-size:17px; padding:16px 34px; border-radius:999px; text-decoration:none; box-shadow:0 10px 26px rgba(230,81,0,.32); transition:transform .12s, box-shadow .12s;}
  .cta-btn:hover{transform:translateY(-2px); box-shadow:0 14px 32px rgba(230,81,0,.4);}
  .cta-btn.ghost{background:#fff; color:var(--orange); border:2px solid var(--orange); box-shadow:none;}
  .micro{font-size:12.5px; color:var(--sub); margin-top:10px;}
  .cta-btn.line{background:#06C755; box-shadow:0 8px 20px rgba(6,199,85,.30);}
  .cta-btn.tel{background:#1f7a43; box-shadow:0 8px 20px rgba(31,122,67,.26);}
  .hdr-actions{display:flex; align-items:center; gap:12px;}
  .hdr-tel{font-weight:900; color:var(--green); font-size:15px; text-decoration:none; white-space:nowrap;}
  header .cta-btn.line{font-size:13px; padding:10px 16px;}
  @media(max-width:720px){ .hdr-tel{display:none;} .hdr-actions .line{display:none;} }
  .hero-urgent{margin-top:16px; font-size:14px; color:#d3dcee;}
  .hero-urgent b{color:#fff;}
  /* floating CTA */
  .floatcta{position:fixed; right:18px; bottom:18px; z-index:60; display:flex; flex-direction:column; gap:12px;}
  .floatcta a{width:60px; height:60px; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#fff; font-weight:900; text-decoration:none; box-shadow:0 8px 22px rgba(0,0,0,.28); line-height:1.1;}
  .floatcta a .ic{font-size:22px;} .floatcta a small{font-size:9px; font-weight:800;}
  .floatcta .fline{background:#06C755;} .floatcta .ftel{background:#1f7a43;}
  /* 所長メッセージ */
  .cho{background:#faf7f2;}
  .cho .cwrap{display:grid; grid-template-columns:280px 1fr; gap:38px; align-items:center;}
  .cho .photo{aspect-ratio:4/5; border-radius:18px; background:linear-gradient(160deg,#e3e9f2,#cbd5e3); position:relative; display:flex; align-items:center; justify-content:center; color:#8a95a8;}
  .cho .photo .pf{font-size:60px;} .cho .photo .pl{position:absolute; bottom:12px; font-size:11.5px; font-weight:800;}
  .cho h3{font-size:20px; font-weight:900; color:var(--navy);}
  .cho p{font-size:15px; color:var(--ink); margin-top:14px; line-height:2.05;}
  .cho .sign{margin-top:16px; text-align:right; font-weight:900; color:var(--navy);}
  @media(max-width:760px){ .cho .cwrap{grid-template-columns:1fr;} .cho .photo{max-width:240px; margin:0 auto;} }
  /* お客様の声 */
  .voicesbg{background:var(--paper);}
  .voices{display:grid; grid-template-columns:1fr 1fr; gap:22px; margin-top:40px;}
  .voice{background:#fff; border:1px solid var(--line); border-radius:16px; padding:24px; display:flex; gap:18px; align-items:flex-start;}
  .voice .av{flex:none; width:64px; height:64px; border-radius:50%; background:linear-gradient(160deg,#e3e9f2,#cbd5e3); display:flex; align-items:center; justify-content:center; font-size:28px;}
  .voice .vq{font-size:14.5px; color:var(--ink); line-height:1.9;}
  .voice .vn{font-size:12.5px; color:var(--sub); font-weight:800; margin-top:10px;}
  @media(max-width:760px){ .voices{grid-template-columns:1fr;} }
  .cta-multi{display:flex; gap:14px; justify-content:center; flex-wrap:wrap; margin-top:6px;}
  /* 安心バー */
  .assure-bar{background:#fff; border-bottom:1px solid var(--line);}
  .assure-bar .wrap{display:flex; flex-wrap:wrap; gap:10px 26px; justify-content:center; padding:15px 22px; font-size:13.5px; font-weight:800; color:var(--ink);}
  .assure-bar span{white-space:nowrap;} .assure-bar b{color:var(--green);}
  /* 中間CTA */
  .midcta{background:linear-gradient(135deg,#fff3e6,#ffe6cf);}
  .midcta .wrap{display:flex; align-items:center; justify-content:space-between; gap:18px; padding:26px 22px; flex-wrap:wrap;}
  .midcta .mct{font-size:19px; font-weight:900; color:var(--navy);}
  .midcta .mct small{display:block; font-size:12.5px; font-weight:700; color:var(--sub); margin-top:2px;}
  .midcta .mctb{display:flex; gap:12px; flex-wrap:wrap;}
  /* 相談の流れ */
  .steps{display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:40px;}
  .step3{background:#fff; border:1px solid var(--line); border-radius:16px; padding:26px 22px; text-align:center;}
  .step3 .sn3{width:44px; height:44px; border-radius:50%; background:linear-gradient(135deg,#E65100,#f39c12); color:#fff; font-weight:900; font-size:20px; display:flex; align-items:center; justify-content:center; margin:0 auto 10px;}
  .step3 .emj{font-size:30px;}
  .step3 h3{font-size:17px; font-weight:900; margin-top:6px;}
  .step3 p{font-size:13.5px; color:var(--sub); margin-top:8px;}
  @media(max-width:820px){ .steps{grid-template-columns:1fr;} }
  /* フォーム同意 */
  .consent{display:flex; gap:8px; align-items:flex-start; font-size:12px; color:var(--sub); margin-top:16px;}
  .consent input{width:auto; margin-top:2px;}
  .consent a{color:var(--blue);}
  /* 事務所情報 */
  .officeinfo{background:#0b1020; color:#9aa5b8; font-size:12.5px; padding:26px 0; border-top:1px solid rgba(255,255,255,.06);}
  .officeinfo .wrap{display:grid; grid-template-columns:repeat(2,1fr); gap:6px 30px;}
  .officeinfo b{color:#cfd6e4;}
  @media(max-width:640px){ .officeinfo .wrap{grid-template-columns:1fr;} }

  /* header */
  header{position:sticky; top:0; z-index:40; background:rgba(255,255,255,.92); backdrop-filter:blur(8px); border-bottom:1px solid var(--line);}
  header .wrap{display:flex; align-items:center; justify-content:space-between; height:64px;}
  .brand{font-weight:900; font-size:16px; color:var(--navy); letter-spacing:.02em;}
  .brand small{display:block; font-size:10.5px; color:var(--sub); font-weight:700; letter-spacing:.08em;}
  header .cta-btn{font-size:14px; padding:10px 20px;}
  @media(max-width:640px){ header .cta-btn{padding:9px 15px; font-size:12.5px;} .brand{font-size:14px;} }

  /* hero */
  .hero{position:relative; background:linear-gradient(160deg,#13203b 0%,#1a1a2e 55%,#28234c 100%); color:#fff; overflow:hidden;}
  .hero::before{content:""; position:absolute; right:-120px; top:-80px; width:420px; height:420px; background:radial-gradient(circle,rgba(243,156,18,.28),transparent 65%);}
  .hero::after{content:""; position:absolute; left:-100px; bottom:-120px; width:380px; height:380px; background:radial-gradient(circle,rgba(76,175,80,.20),transparent 65%);}
  .hero .wrap{position:relative; padding-top:80px; padding-bottom:88px;}
  .hbadge{display:inline-block; font-size:13px; font-weight:800; letter-spacing:.06em; color:#bcd3f5; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.18); padding:7px 16px; border-radius:999px;}
  .hero h1{font-size:52px; font-weight:900; line-height:1.28; margin:22px 0 0; letter-spacing:.01em;}
  .hero h1 .glow{color:var(--orange-l);}
  .hero .lead{font-size:19px; color:#d3dcee; margin-top:22px; max-width:720px;}
  .hero .lead b{color:#fff;}
  .hero .cta-row{margin-top:34px; display:flex; gap:16px; align-items:center; flex-wrap:wrap;}
  .hero .hmeta{margin-top:30px; display:flex; gap:26px; flex-wrap:wrap; font-size:13px; color:#9fb0cd;}
  .hero .hmeta b{color:#fff; font-size:15px;}
  @media(max-width:720px){ .hero h1{font-size:34px;} .hero .lead{font-size:16px;} }
  .hero-photo{position:absolute; right:0; top:0; width:56%; height:100%; object-fit:cover; object-position:25% center; z-index:0;}
  .hero-ov{position:absolute; inset:0; z-index:1; background:linear-gradient(100deg,#13203b 0%,#13203b 38%,rgba(19,32,59,.82) 52%,rgba(19,32,59,.22) 100%);}
  .hero .wrap{position:relative; z-index:2;}
  @media(max-width:860px){ .hero-photo{width:100%; object-position:62% center;} .hero-ov{background:linear-gradient(180deg,rgba(19,32,59,.74),rgba(19,32,59,.92));} }
  /* embedded photos */
  img.cho-photo{width:100%; aspect-ratio:4/5; object-fit:cover; object-position:center 18%; border-radius:18px; display:block;}
  img.v-av{width:64px; height:64px; border-radius:50%; object-fit:cover; object-position:center 20%; flex:none;}
  /* RTB */
  .rtbbg{background:#eef2f8;}
  .rtb{display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:40px;}
  .rtbc{background:#fff; border:1px solid var(--line); border-top:5px solid var(--blue); border-radius:16px; padding:26px 22px; text-align:center;}
  .rtbc .rtbi{font-size:38px;}
  .rtbc h3{font-size:16.5px; font-weight:900; margin-top:10px; color:var(--navy);}
  .rtbc p{font-size:13.5px; color:var(--sub); margin-top:10px; text-align:left; line-height:1.8;}
  @media(max-width:820px){ .rtb{grid-template-columns:1fr;} }

  /* 共感・課題 */
  .painbg{background:var(--paper);}
  .pain-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-top:40px;}
  .pain{background:#fff; border:1px solid var(--line); border-radius:16px; padding:24px 20px; text-align:center; box-shadow:0 6px 18px rgba(26,26,46,.05);}
  .pain .emo{font-size:34px;}
  .pain-img{width:118px; height:118px; object-fit:contain; display:block; margin:0 auto 2px;}
  .eco{max-width:840px; margin:16px auto 0; background:#f3faf4; border:1px solid #cce9d0; border-left:5px solid var(--green); border-radius:12px; padding:14px 18px; font-size:14px; color:var(--ink); line-height:1.8;}
  .eco b{color:var(--green);}
  .plan-ico{width:62px; height:62px; object-fit:contain; display:block;}
  .rtb-ico{width:76px; height:76px; object-fit:contain; display:block; margin:0 auto;}
  .r-ico{width:60px; height:60px; object-fit:contain; flex:none;}
  .growth-hero{display:block; width:100%; max-width:720px; margin:26px auto 10px; border-radius:16px;}
  #scrollbar{position:fixed; top:0; left:0; height:3px; width:0; background:linear-gradient(90deg,#E65100,#f39c12); z-index:90; pointer-events:none;}
  /* === 動き（モーション）※prefers-reduced-motionでは無効化 === */
  @media (prefers-reduced-motion: no-preference){
    @keyframes fadeUp{from{opacity:0;transform:translateY(22px);}to{opacity:1;transform:none;}}
    @keyframes heroZoom{from{transform:scale(1.09);}to{transform:scale(1);}}
    @keyframes fpulse{0%,100%{transform:translateY(0);}50%{transform:translateY(-5px);}}
    .hero .hbadge{animation:fadeUp 1.1s .15s cubic-bezier(.16,1,.3,1) both;}
    .hero h1{animation:fadeUp 1.2s .35s cubic-bezier(.16,1,.3,1) both;}
    .hero .lead{animation:fadeUp 1.2s .6s cubic-bezier(.16,1,.3,1) both;}
    .hero .cta-row{animation:fadeUp 1.2s .85s cubic-bezier(.16,1,.3,1) both;}
    .hero .hero-urgent{animation:fadeUp 1.2s 1.05s cubic-bezier(.16,1,.3,1) both;}
    .hero .hmeta{animation:fadeUp 1.2s 1.25s cubic-bezier(.16,1,.3,1) both;}
    .hero-photo{animation:heroZoom 16s ease-out both;}
    .reveal{opacity:0; transform:translateY(32px) scale(.965); filter:blur(6px); will-change:transform,opacity; transition:opacity 1.2s cubic-bezier(.16,1,.3,1), transform 1.2s cubic-bezier(.16,1,.3,1), filter 1.2s cubic-bezier(.16,1,.3,1);}
    .reveal.in{opacity:1; transform:none; filter:none;}
    .rmask{overflow:hidden; padding-bottom:2px;} .rmask .rmask-i{display:block; transform:translateY(120%); transition:transform 1.4s cubic-bezier(.16,1,.3,1);}
    .rmask.in .rmask-i{transform:none;}
    .img-rv{clip-path:inset(0 0 100% 0); transform:scale(1.08); transition:clip-path 1.05s cubic-bezier(.16,1,.3,1), transform 1.05s cubic-bezier(.16,1,.3,1);}
    .img-rv.in{clip-path:inset(0 0 0 0); transform:none;}
    .pain,.reason,.plan,.rtbc,.step3,.voice{transition:transform .2s ease, box-shadow .2s ease;}
    .pain:hover,.reason:hover,.plan:hover,.rtbc:hover,.step3:hover,.voice:hover{transform:translateY(-5px); box-shadow:0 16px 34px rgba(26,26,46,.12);}
    .floatcta a{animation:fpulse 2.8s ease-in-out infinite;}
    .floatcta a:last-child{animation-delay:.4s;}
    header{transition:box-shadow .22s ease;}
    header.scrolled{box-shadow:0 6px 20px rgba(26,26,46,.09);}
  }
  .pain .pt{font-weight:800; font-size:15.5px; margin-top:10px; color:var(--ink);}
  .pain .pd{font-size:13px; color:var(--sub); margin-top:6px;}
  @media(max-width:860px){ .pain-grid{grid-template-columns:1fr 1fr;} }

  /* 転換 */
  .turn{background:linear-gradient(135deg,#8e2f2f,#6f2222); color:#fff; text-align:center;}
  .turn .q{font-size:24px; font-weight:900; line-height:1.6;}
  .turn .a{font-size:16px; margin-top:14px; color:#f0d6d3;}
  .turn .a b{color:#fff;}

  /* コンセプト（守り×攻め） */
  .concept .duo{display:grid; grid-template-columns:1fr auto 1fr; gap:22px; align-items:stretch; margin-top:44px;}
  .cbox{border-radius:18px; padding:28px 26px; border:2px solid;}
  .cbox .tag{font-size:12.5px; font-weight:900; letter-spacing:.1em;}
  .cbox h3{font-size:22px; font-weight:900; margin:8px 0 8px;}
  .cbox p{font-size:14.5px; color:var(--sub);}
  .cbox.def{border-color:var(--blue); background:#eff5fc;} .cbox.def .tag,.cbox.def h3{color:var(--blue);}
  .cbox.atk{border-color:var(--orange); background:#fff6ee;} .cbox.atk .tag,.cbox.atk h3{color:var(--orange);}
  .cplus{display:flex; align-items:center; justify-content:center; font-size:34px; font-weight:900; color:#c2c8d4;}
  .concept .payoff{margin-top:34px; text-align:center; background:var(--navy); color:#fff; border-radius:18px; padding:30px;}
  .concept .payoff .big{font-size:28px; font-weight:900;} .concept .payoff .big .glow{color:var(--orange-l);}
  .concept .payoff .note{font-size:14px; color:#c7d0e2; margin-top:8px;}
  @media(max-width:820px){ .concept .duo{grid-template-columns:1fr;} .cplus{transform:rotate(90deg); padding:6px 0;} }

  /* 選ばれる理由 */
  .reasons{display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:40px;}
  .reason{display:flex; gap:16px; background:#fff; border:1px solid var(--line); border-radius:16px; padding:22px 24px;}
  .reason .rn{flex:none; width:44px; height:44px; border-radius:12px; background:#fff6ee; color:var(--orange); font-weight:900; font-size:20px; display:flex; align-items:center; justify-content:center;}
  .reason h3{font-size:17px; font-weight:900;}
  .reason p{font-size:13.5px; color:var(--sub); margin-top:4px;}
  @media(max-width:760px){ .reasons{grid-template-columns:1fr;} }

  /* 3プラン */
  .plansbg{background:var(--paper);}
  .axis{display:flex; justify-content:space-between; font-size:12.5px; font-weight:800; color:var(--sub); margin:34px 4px 10px;}
  .plans{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
  .plan{background:#fff; border:1px solid var(--line); border-top:6px solid; border-radius:16px; padding:26px 22px; display:flex; flex-direction:column;}
  .plan.p1{border-top-color:var(--green);} .plan.p2{border-top-color:var(--orange);} .plan.p3{border-top-color:var(--blue);}
  .plan .pemoji{font-size:30px;}
  .plan h3{font-size:19px; font-weight:900; margin-top:6px;}
  .plan .who{font-size:12.5px; font-weight:800; color:#fff; padding:3px 10px; border-radius:999px; display:inline-block; margin-top:8px;}
  .plan.p1 .who{background:var(--green);} .plan.p2 .who{background:var(--orange);} .plan.p3 .who{background:var(--blue);}
  .plan ul{list-style:none; margin-top:14px;}
  .plan li{position:relative; padding-left:20px; font-size:13.5px; color:var(--ink); margin:8px 0;}
  .plan li::before{content:"✓"; position:absolute; left:0; color:var(--green); font-weight:900;}
  .plan .price{margin-top:auto; padding-top:14px; font-size:13px; color:var(--sub);}
  .plan .price b{font-size:19px; color:var(--ink);}
  .flow{margin-top:22px; background:#fff; border:1px dashed #f0c9a8; border-radius:14px; padding:16px 20px; font-size:13.5px; color:var(--ink);}
  .flow b{color:var(--orange);}
  /* 案A 主従化（丸投げ本命を主役に） */
  .heroplan{background:#fff; border:1px solid #f0c9a8; border-top:7px solid var(--orange); border-radius:20px; box-shadow:0 18px 40px rgba(230,81,0,.12); overflow:hidden; margin-top:8px;}
  .heroplan .ribbon{background:linear-gradient(135deg,#E65100,#f39c12); color:#fff; font-weight:900; font-size:15px; text-align:center; padding:10px; letter-spacing:.03em;}
  .heroplan .hpbody{display:grid; grid-template-columns:1.15fr 1fr; gap:26px; padding:28px 32px 32px; align-items:center;}
  .heroplan h3{font-size:25px; font-weight:900;}
  .heroplan .who{display:inline-block; background:var(--orange); color:#fff; font-size:13px; font-weight:800; padding:4px 13px; border-radius:999px; margin-top:10px;}
  .heroplan .do-label{font-size:11.5px; font-weight:800; color:var(--orange); letter-spacing:.04em; margin-top:16px;}
  .heroplan ul{list-style:none; margin-top:8px;}
  .heroplan .benefit{margin-top:14px; padding-top:13px; border-top:1px dashed #f0c9a8; font-size:13.5px; color:var(--ink); font-weight:600; line-height:1.75;}
  .heroplan li{position:relative; padding-left:24px; font-size:15.5px; margin:10px 0; font-weight:600;}
  .heroplan li::before{content:"✓"; position:absolute; left:0; color:var(--orange); font-weight:900;}
  .heroplan .hpprice{text-align:center;}
  .heroplan .hpprice .lbl{font-size:14px; color:var(--sub);}
  .heroplan .hpprice b{display:block; font-size:32px; color:var(--ink); margin:2px 0;}
  .heroplan .hpprice small{font-size:12px; color:var(--sub);}
  .subhead{text-align:center; font-size:14px; font-weight:800; color:var(--sub); margin:28px 0 16px;}
  .subplans{display:grid; grid-template-columns:1fr 1fr; gap:18px;}
  .subplan{background:#fff; border:1px solid var(--line); border-top:5px solid; border-radius:14px; padding:20px;}
  .subplan.s1{border-top-color:var(--green);} .subplan.s3{border-top-color:var(--blue);}
  .subplan h4{font-size:16px; font-weight:900;}
  .subplan .who2{font-size:12px; font-weight:800; color:var(--sub); margin-top:5px;}
  .subplan .sc{font-size:12.5px; font-weight:800; margin-top:9px;}
  .subplan.s1 .sc{color:var(--green);} .subplan.s3 .sc{color:var(--blue);}
  .subplan .pr{margin-top:9px; font-size:12.5px; color:var(--sub);} .subplan .pr b{font-size:17px; color:var(--ink);}
  .plan-note{font-size:11.5px; color:var(--sub); margin-top:8px;}
  .plan-note.incl{color:var(--blue); font-weight:800;}
  @media(max-width:820px){ .heroplan .hpbody{grid-template-columns:1fr; text-align:center;} .heroplan ul{text-align:left;} .subplans{grid-template-columns:1fr;} }
  @media(max-width:820px){ .plans{grid-template-columns:1fr;} }

  /* 事業計画サポート */
  .growth .gwrap{display:grid; grid-template-columns:1.1fr .9fr; gap:34px; align-items:center; margin-top:40px;}
  .gapfig{display:grid; grid-template-columns:auto 1fr auto; gap:12px; align-items:center;}
